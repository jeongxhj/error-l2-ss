<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Only lets colcon and rosdep find this plain python package; the library itself does not use ROS. -->
<package format="3">
  <name>forzaeth_mpc</name>
  <version>0.1.0</version>
  <description>ForzaETH F1TENTH model predictive controllers and a ROS-free simulator</description>
  <maintainer email="edoardo.ghignone@pbl.ee.ethz.ch">ForzaETH</maintainer>
  <license>MIT</license>

  <exec_depend>forza_config</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- casadi and acados_template come from install/install_acados.sh -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
