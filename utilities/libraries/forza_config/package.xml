<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Only lets colcon and rosdep find this plain python package; the library itself does not use ROS. -->
<package format="3">
  <name>forza_config</name>
  <version>0.1.0</version>
  <description>Pydantic schemas and path-based loaders for the ForzaETH car configs. No ROS.</description>
  <maintainer email="edoardo.ghignone@pbl.ee.ethz.ch">ForzaETH</maintainer>
  <license>MIT</license>

  <exec_depend>python3-pydantic</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
